{
  "name": "back-eduia",
  "version": "0.1.0",
  "description": "EduIA backend API (NestJS 11 + Fastify 5 + TypeORM 1 + PostgreSQL 18)",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.1.1",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "build": "node scripts/check-lockfiles.mjs && nest build",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lockfiles": "node scripts/check-lockfiles.mjs",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "ci": "node scripts/check-lockfiles.mjs && eslint src test && tsc --noEmit && vitest run && nest build",
    "typeorm": "bun node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "bun node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "bun node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "bun node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "bun node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "keys:generate": "bash scripts/generate-jwt-keys.sh"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "argon2": "0.45.1",
    "fastify": "5.11.3",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "chokidar": "5.0.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.10"
  }
}
