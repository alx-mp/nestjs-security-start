{
  "name": "back-eduia",
  "version": "0.1.0",
  "description": "EduIA backend API (NestJS 12 + Fastify 5 + TypeORM 1 + PostgreSQL 18)",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.8.1",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "build": "node scripts/check-lockfiles.mjs && nest build",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lockfiles": "node scripts/check-lockfiles.mjs",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "ci": "node scripts/check-lockfiles.mjs && eslint src test && tsc --noEmit && vitest run && nest build",
    "typeorm": "bun node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "bun node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "bun node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "bun node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "bun node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "keys:generate": "bash scripts/generate-jwt-keys.sh"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "nestjs-pino": "5.2.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.12",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "chokidar": "5.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
