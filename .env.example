# Copy to .env for local development. Production never uses a .env file:
# the container gets its config from compose env_file + docker secrets.

NODE_ENV=development
# Loopback on purpose: only the Astro BFF (dashboard-eduai) talks to this API.
# The production container overrides HOST to 0.0.0.0.
HOST=127.0.0.1
PORT=3125
APP_VERSION=0.1.0-dev

# How much of X-Forwarded-For to believe: the number of proxy hops to trust
# (1 behind a single Caddy), a comma-separated list of proxies allowed to set
# it, or false to trust nothing. Avoid true: it trusts the whole chain, so a
# client can forge its own IP and spend another one's rate limit. In dev the
# API is reached directly, so false is right.
TRUST_PROXY=false

# Max JSON body size in bytes (default 512 KiB).
BODY_LIMIT_BYTES=524288

# fatal | error | warn | info | debug | trace (default: debug in dev, info in prod)
#LOG_LEVEL=info

# Comma-separated allowlist. Required and '*'-free in production. With the BFF
# in front the browser never calls this API directly, so the only entry is the
# front's own origin, and only matters if that ever changes.
CORS_ORIGINS=http://localhost:4325

# Swagger UI at /docs. Defaults: on in dev, off in production.
#SWAGGER_ENABLED=false

# PostgreSQL 18 (host container postgres-18 on 5433). Every secret also
# accepts a *_FILE variant pointing to a file (docker secrets); the file wins
# over the plain variable.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=eduia
DB_PASSWORD=changeme
#DB_PASSWORD_FILE=/root/.eduia-db-password
DB_DATABASE=eduia
DB_SSL=false
DB_POOL_MAX=10

# ES256 keypair for access tokens. Generate with: bun run keys:generate
JWT_PRIVATE_KEY_FILE=keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt-public.pem
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=1209600

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Heap ceiling for the /health degraded state. Keep below the container
# memory limit so health degrades before the kernel OOM-kills the process.
#HEALTH_HEAP_LIMIT_MB=350

# One-time bootstrap of the first admin. Remove after first boot.
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=change-me-please
#ADMIN_PASSWORD_FILE=/run/secrets/admin_password
