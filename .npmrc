# Registry and auth only.
#
# pnpm (11 and later) reads its own settings from pnpm-workspace.yaml, not
# from here. Adding minimumReleaseAge, engineStrict, allowBuilds or friends to
# this file does nothing at all and gives you no warning about it.

registry=https://registry.npmjs.org/

# pnpm ignores this line too: its exact-version switch is saveExact in
# pnpm-workspace.yaml. It stays for the same reason as engine-strict below,
# because npm does read it.
save-exact=true

# npm is not the package manager for this project (scripts/enforce-pnpm.mjs
# rejects it). If someone still reaches it with --ignore-scripts, at least make
# it respect the engines field.
engine-strict=true
