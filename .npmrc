# Registry and auth only.
#
# pnpm 11 reads its own settings from pnpm-workspace.yaml, not from here.
# Adding minimumReleaseAge, engineStrict, allowBuilds or friends to this file
# does nothing at all and gives you no warning about it.

registry=https://registry.npmjs.org/

# Exact versions in package.json, no ranges.
save-exact=true

# npm is not the package manager for this project (scripts/enforce-pnpm.mjs
# rejects it). If someone still reaches it with --ignore-scripts, at least make
# it respect the engines field.
engine-strict=true
